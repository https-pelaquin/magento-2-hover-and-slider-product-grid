/** @var $block \Magento\Catalog\Block\Product\Image */
/** @var $escaper \Magento\Framework\Escaper */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */

$width = (int)$block->getWidth();
$height = (int)$block->getHeight();
$paddingBottom = $block->getRatio() * 100;
$productId = (int)$block->getProductId();
$hoverImageUrl = (string)$block->getData('hover_image_url');
$primaryImageClass = trim((string)$block->getClass() . ' bp-product-image-primary');
$hoverImageClass = trim((string)$block->getClass() . ' bp-product-image-hover');
?>

<span class="product-image-container product-image-container-<?= /* @noEscape */ $productId ?>">
    <span class="product-image-wrapper bp-product-hover-image">
        <img class="<?= $escaper->escapeHtmlAttr($primaryImageClass) ?>"
            <?php foreach ($block->getCustomAttributes() as $name => $value): ?>
                <?= $escaper->escapeHtmlAttr($name) ?>="<?= $escaper->escapeHtmlAttr($value) ?>"
            <?php endforeach; ?>
            src="<?= $escaper->escapeUrl($block->getImageUrl()) ?>"
            loading="lazy"
            width="<?= $escaper->escapeHtmlAttr($block->getWidth()) ?>"
            height="<?= $escaper->escapeHtmlAttr($block->getHeight()) ?>"
            alt="<?= $escaper->escapeHtmlAttr($block->getLabel()) ?>" />
        <img class="<?= $escaper->escapeHtmlAttr($hoverImageClass) ?>"
            src="<?= $escaper->escapeUrl($hoverImageUrl) ?>"
            loading="lazy"
            width="<?= $escaper->escapeHtmlAttr($block->getWidth()) ?>"
            height="<?= $escaper->escapeHtmlAttr($block->getHeight()) ?>"
            alt=""
            aria-hidden="true" />
    </span>
</span>
<?php
$styles = <<<STYLE
.product-image-container-{$productId} {
    width: {$width}px;
    height: auto;
    aspect-ratio: {$width} / {$height};
}
.product-image-container-{$productId} span.product-image-wrapper {
    height: 100%;
    width: 100%;
}
@supports not (aspect-ratio: auto) {
    .product-image-container-{$productId} span.product-image-wrapper {
        padding-bottom: {$paddingBottom}%;
    }
}
STYLE;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('style', [], $styles, false) ?>
